#VRML_SIM R2025a utf8
# Соревнование Go2, уровень 1 «Квалификация»: прямая, S-образный участок и финиш
# Фиксированный basicTimeStep обеспечивает повторяемость, ROBOT запускает контроллер участника
# При оценке контроллер участника заменяется, REF запускает судью с правами Supervisor
# Фон, освещение и декор не меняют геометрию столкновений пола, стен и робота

EXTERNPROTO "../common/protos/Go2.proto"
EXTERNPROTO "../common/protos/Checkpoint.proto"
EXTERNPROTO "../common/protos/Wall.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/toys/protos/RubberDuck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/containers/protos/PlasticCrate.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/pallet/protos/WoodenPalletStack.proto"

# Параметры физики взяты из проверенной симуляции, на них модель MNN ходит устойчиво
# Шаг 4 мс, трение 1,3, без изменений damping и CFM, эти параметры не меняем
WorldInfo {
  basicTimeStep 4
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "ground"
      coulombFriction [ 1.3 ]
      bounce 0
    }
  ]
}
Viewpoint {
  orientation -0.32 0.31 0.9 1.66
  position 0.2 -3.8 3.0
  follow "Go2"
  followType "Tracking Shot"
  followSmoothness 0.35
}
TexturedBackground { texture "factory" }
TexturedBackgroundLight { texture "factory" luminosity 1.6 }
DirectionalLight { direction 0.6 -1 -0.9 intensity 2.2 castShadows TRUE }

# Пол с клетчатым покрытием, форма для столкновений остаётся прежней
DEF FLOOR Solid {
  translation 3.5 0 -0.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture { url [ "../common/protos/textures/Checker.png" ] }
        textureTransform TextureTransform { scale 12 8 }
        roughness 0.6
        metalness 0.0
      }
      geometry Box { size 24 16 1.0 }
    }
  ]
  boundingObject Box { size 24 16 1.0 }
  contactMaterial "ground"
}

# Робот участника, при оценке заменяется его контроллер
# Go2 движется с полной физикой, моментами суставов управляет модель ходьбы из прошивки
# См common/locomotion/policy_walk.py, supervisor FALSE не даёт роботу начислять себе баллы
DEF ROBOT Go2 {
  translation 0 0 0.34
  rotation 0 0 1 0
  name "Go2"
  controller "participant"
  supervisor FALSE
}

# Судья читает положение робота, считает баллы и сохраняет result.json
DEF REF Robot {
  name "referee"
  controller "referee"
  controllerArgs [ "../../config/level1.json" ]
  supervisor TRUE
}

# Светящиеся контрольные площадки, судья меняет их цвет после зачёта
# Маршрут: прямая, S-образный участок, cp2, налево к cp3, направо, налево к cp4, направо к финишу
DEF CP1 Checkpoint { translation 3.4 4.441e-16 0.03 name "cp1" radius 0.5 color 0.95 0.85 0.1 }
DEF CP2 Checkpoint { translation 6.8 4.441e-16 0.03 name "cp2" radius 0.5 }
DEF CP3 Checkpoint { translation 8.5 1.7 0.03 name "cp3" radius 0.45 }
DEF CP4 Checkpoint { translation 8.6 4.4 0.03 name "cp4" radius 0.45 }
DEF FINISH Checkpoint { translation 11.8 5.2 0.03 name "finish" radius 0.3 color 0.6 0.2 0.9 }

# S-образный участок: обходим Wall1 со стороны y>0, затем Wall2 со стороны y<0
  Wall { translation 12.6 -0.8 0.25 size 0.1 1.2 0.5 name "gw0" }
  Wall { translation 2.2 4.8 0.25 size 1.2 0.1 0.5 name "gw1" }
  Wall { translation 4.6 6.4 0.25 size 2.4 0.1 0.5 name "gw2" }
  Wall { translation 5.4 5.6 0.25 size 3.2 0.1 0.5 name "gw3" }
  Wall { translation -0.2 6.4 0.25 size 0.1 2.5 0.5 name "gw4" }
  Wall { translation -0.2 -1.6 0.25 size 3.2 0.1 0.5 name "gw5" }
  Wall { translation 10.2 4 0.25 size 2.8 0.1 0.5 name "gw6" }
  Wall { translation 2.2 4 0.25 size 2.8 0.1 0.5 name "gw7" }
  Wall { translation 1.4 4 0.25 size 3.6 0.1 0.5 name "gw8" }
  Wall { translation 10.2 1.6 0.25 size 1.8 0.1 0.5 name "gw9" }
  Wall { translation 5.9 -2.4 0.25 size 15.4 0.1 0.5 name "gw10" }
  Wall { translation 5.9 7.9 0.25 size 15.4 0.1 0.5 name "gw11" }
  Wall { translation -1.8 2.75 0.25 size 0.1 10.3 0.5 name "gw12" }
  Wall { translation 13.6 2.75 0.25 size 0.1 10.3 0.5 name "gw13" }

# После cp2: налево на север к cp3, направо на восток, налево на север к cp4, направо к финишу
# Ширина всех коридоров 1,8 м
    # Внешняя стена первого поворота
    # Южная сторона восточного участка C
    # Западная сторона северного участка B
    # Северная сторона участка C, заканчивается у третьего поворота
    # Восточная сторона северного участка D, внешняя стена третьего поворота
    # Западная сторона участка D
    # Северная сторона восточного участка E, внешняя стена четвёртого поворота
    # Южная сторона участка E

# Декор за пределами трассы, без столкновений или на достаточном расстоянии
# Баннеры спонсора МТС по бокам трассы, без столкновений
DEF BANNER_N Solid {
  translation 3.75 4.3 1.15
  children [
    Shape { appearance PBRAppearance { baseColor 0.89 0.04 0.07 emissiveColor 0.5 0.02 0.03 emissiveIntensity 0.5 roughness 0.4 metalness 0.1 } geometry Box { size 4.0 0.06 1.1 } }
    Pose { translation -1.9 0 -0.9 children [ Shape { appearance PBRAppearance { baseColor 0.14 0.14 0.16 roughness 0.5 metalness 0.6 } geometry Box { size 0.08 0.08 1.9 } } ] }
    Pose { translation  1.9 0 -0.9 children [ Shape { appearance PBRAppearance { baseColor 0.14 0.14 0.16 roughness 0.5 metalness 0.6 } geometry Box { size 0.08 0.08 1.9 } } ] }
  ]
  name "banner_n"
}
DEF BANNER_S Solid {
  translation 3.75 -3.2 1.15
  children [
    Shape { appearance PBRAppearance { baseColor 0.89 0.04 0.07 emissiveColor 0.5 0.02 0.03 emissiveIntensity 0.5 roughness 0.4 metalness 0.1 } geometry Box { size 4.0 0.06 1.1 } }
    Pose { translation -1.9 0 -0.9 children [ Shape { appearance PBRAppearance { baseColor 0.14 0.14 0.16 roughness 0.5 metalness 0.6 } geometry Box { size 0.08 0.08 1.9 } } ] }
    Pose { translation  1.9 0 -0.9 children [ Shape { appearance PBRAppearance { baseColor 0.14 0.14 0.16 roughness 0.5 metalness 0.6 } geometry Box { size 0.08 0.08 1.9 } } ] }
  ]
  name "banner_s"
}

# Объекты из онлайн-каталога Webots, для загрузки контейнеру судьи нужен доступ к сети
RubberDuck { translation 1.0 2.3 0 scale 2 name "duck1" }
RubberDuck { translation 2.0 2.3 0 scale 2 name "duck2" }
RubberDuck { translation 3.0 2.3 0 scale 2 name "duck3" }
RubberDuck { translation 4.0 2.3 0 scale 2 name "duck4" }
RubberDuck { translation 5.0 2.3 0 scale 2 name "duck5" }
PlasticCrate { translation 13.4 5.2 0 name "crate1" }
PlasticCrate { translation 13.4 5.2 0.28 name "crate2" }
WoodenPalletStack { translation 9.2 -2.2 0 name "pallets" }
